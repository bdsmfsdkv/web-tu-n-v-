$(document).ready(function() {
    if (typeof ROUTE_NAME === 'undefined' || ROUTE_NAME !== 'VPS_DETAIL') {
        return; 
    }
    // Global variables
    let cpuQuantity = 0;
    let ramQuantity = 0;
    let diskQuantity = 0;
    let ipQuantity = 0;

    // Get prices from global variables (should be set in blade template)
    const PRICE_CPU_ADDON = window.PRICE_CPU_ADDON || 0;
    const PRICE_RAM_ADDON = window.PRICE_RAM_ADDON || 0;
    const PRICE_DISK_ADDON = window.PRICE_DISK_ADDON || 0;
    const PRICE_IP_ADDON = window.PRICE_IP_ADDON || 0;
    const VAT = window.VAT || 0;

    // Format currency function
    function formatCurrency(amount) {
        return Math.round(amount).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",") + "đ";
    }

    // Update display values
    function updateDisplayValues() {
        $("#cpu-value").text(cpuQuantity + " vCore");
        $("#ram-value").text(ramQuantity + " GB");
        $("#disk-value").text((diskQuantity * 10) + " GB"); // 1DV = 10GB
        $("#ip-value").text(ipQuantity);
    }

    // Update pricing calculations
    function updatePricing() {
        const cpuPrice = cpuQuantity * PRICE_CPU_ADDON;
        const ramPrice = ramQuantity * PRICE_RAM_ADDON;
        const diskPrice = diskQuantity * PRICE_DISK_ADDON; // PRICE_DISK_ADDON đã được tính sẵn cho 1DV
        const ipPrice = ipQuantity * PRICE_IP_ADDON;

        // Update quantities in table
        $("#sl-addon-cpu").text(cpuQuantity);
        $("#sl-addon-ram").text(ramQuantity);
        $("#sl-addon-disk").text(diskQuantity);
        $("#sl-addon-ip").text(ipQuantity);

        // Update prices in table
        $("#price-addon-cpu").text(formatCurrency(cpuPrice));
        $("#price-addon-ram").text(formatCurrency(ramPrice));
        $("#price-addon-disk").text(formatCurrency(diskPrice));
        $("#price-addon-ip").text(formatCurrency(ipPrice));

        // Calculate totals
        const totalPrice = cpuPrice + ramPrice + diskPrice + ipPrice;
        const vatAmount = totalPrice * VAT / 100;
        const totalPayment = totalPrice + vatAmount;

        // Update total prices
        $("#total-price-upgrade").text(formatCurrency(totalPrice));
        $("#total-vat-upgrade").text(formatCurrency(vatAmount));
        $("#total-payment-upgrade").text(formatCurrency(totalPayment));

        // Show/hide addon rows based on quantity
        $("#show-addon-cpu").toggle(cpuQuantity > 0);
        $("#show-addon-ram").toggle(ramQuantity > 0);
        $("#show-addon-disk").toggle(diskQuantity > 0);
        $("#show-addon-ip").toggle(ipQuantity > 0);

        // Show/hide billing table
        const hasAnyAddon = cpuQuantity > 0 || ramQuantity > 0 || diskQuantity > 0 || ipQuantity > 0;
        //$("#show-bill-upgrade").toggle(hasAnyAddon);

        // Update display values
        updateDisplayValues();
    }

    // Generic function to handle addon changes
    function updateAddon(type, change) {
        const $input = $(`#addon_${type}`);
        const $rangeInput = $(`input[name="addon_${type}"]`);
        
        if (!$input.length) return;

        let currentValue = parseInt($input.val()) || 0;
        let newValue = Math.max(0, Math.min(100, currentValue + change));
        
        // Update the range input
        $input.val(newValue);
        $rangeInput.val(newValue);
        
        // Update corresponding quantity variable
        switch(type) {
            case 'cpu':
                cpuQuantity = newValue;
                break;
            case 'ram':
                ramQuantity = newValue;
                break;
            case 'disk':
                diskQuantity = newValue;
                break;
            case 'ip':
                ipQuantity = newValue;
                break;
        }
        
        updatePricing();
    }

    // Event handlers for step buttons
    $(document).on('click', '.step-up', function() {
        const target = $(this).data('target');
        updateAddon(target, 1);
    });

    $(document).on('click', '.step-down', function() {
        const target = $(this).data('target');
        updateAddon(target, -1);
    });

    // Event handlers for range inputs
    $(document).on('input change', 'input[type="range"]', function() {
        const name = $(this).attr('name');
        const value = parseInt($(this).val()) || 0;
        
        switch(name) {
            case 'addon_cpu':
                cpuQuantity = value;
                break;
            case 'addon_ram':
                ramQuantity = value;
                break;
            case 'addon_disk':
                diskQuantity = value;
                break;
            case 'addon_ip':
                ipQuantity = value;
                break;
        }
        
        updatePricing();
    });

    // Initialize
    function init() {
        // Hide all addon rows initially
        $("#show-addon-cpu, #show-addon-ram, #show-addon-disk, #show-addon-ip").hide();
        
        // Hide billing table initially
        //$("#show-bill-upgrade").hide();
        
        // Reset all quantities
        cpuQuantity = ramQuantity = diskQuantity = ipQuantity = 0;
        
        // Update display
        updatePricing();
    }

    // Initialize the system
    init();
});
/* END VPS Upgrade System */