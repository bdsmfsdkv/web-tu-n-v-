                        });
                        resetCoupon();
                    }
                }
            }
        });
    });

    const applyCouponBtn = hostRenewForm.querySelector("#apply-coupon");
    if (applyCouponBtn) {
        applyCouponBtn.addEventListener("click", function () {
            let couponInput = hostRenewForm.querySelector('input[name="coupon"]');
            let code = couponInput ? couponInput.value.trim() : '';
            
            if (!code) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thông báo',
                    text: 'Vui lòng nhập mã giảm giá!',
                    confirmButtonText: 'Đóng'
                });
                return;
            }

            let selectedDuration = hostRenewForm.querySelector('input[name="duration"]:checked');
            if (!selectedDuration) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thông báo',
                    text: 'Vui lòng chọn chu kỳ gia hạn trước khi áp dụng mã giảm giá!',
                    confirmButtonText: 'Đóng'
                });
                return;
            }

            let applyButton = applyCouponBtn;
            let originalHTML = applyButton.innerHTML;
            let originalDisabled = applyButton.disabled;

            applyButton.innerHTML = '<i class="fad fa-spinner fa-spin me-1"></i>Đang kiểm tra...';
            applyButton.disabled = true;

            Swal.fire({
                title: 'Đang xử lý...',
                text: 'Vui lòng chờ trong giây lát',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            let apiUrl = `/api/private/v3/coupon/checking?code=${encodeURIComponent(code)}`;
            
            fetch(apiUrl, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${ACCESS_TOKEN}`,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.json())
                .then(result => {
                    applyButton.innerHTML = originalHTML;
                    applyButton.disabled = originalDisabled;

                    Swal.close();

                    if (result.status === "success" && result.data) {
                        let validationResult = validateCoupon(result.data);
                        if (validationResult.isValid) {
                            let basePrice = calculateCurrentTotalPayment();
                            let discountAmount = calculateCouponDiscount(basePrice, result.data);
                            
                            if (discountAmount > 0) {
                                currentDiscount = result.data.type === 'percent' ? parseFloat(result.data.discount) : 0;
                                currentCouponData = result.data;
                                
                                displayCouponInfo(result.data);
                                
                                updateBillInfo();
                                
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: 'Áp dụng mã giảm giá thành công!',
                                    confirmButtonText: 'Đóng'
                                });
                            } else {
                                resetCoupon();
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Không thể áp dụng',
                                    text: 'Mã giảm giá không thể áp dụng cho đơn hàng này.',
                                    confirmButtonText: 'Đóng'
                                });
                            }
                        } else {
                            resetCoupon();
                            Swal.fire({
                                icon: validationResult.icon || 'error',
                                title: validationResult.title || 'Lỗi',
                                text: validationResult.message,
                                confirmButtonText: 'Đóng'
                            });
                        }
                    } else {
                        resetCoupon();
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: result.message || 'Mã giảm giá không hợp lệ hoặc không có giảm giá.',
                            confirmButtonText: 'Đóng'
                        });
                    }
                })
                .catch((error) => {
                    console.error('Coupon validation error:', error);
                    
                    applyButton.innerHTML = originalHTML;
                    applyButton.disabled = originalDisabled;
                    
                    Swal.close();
                    
                    resetCoupon();
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi kết nối',
                        text: 'Không thể kiểm tra mã giảm giá. Vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                });
        });
    }

    function calculateCouponDiscount(basePrice, couponData) {
        if (!basePrice || basePrice <= 0) {
            return 0;
        }
        
        if (!couponData || !couponData.type || !couponData.discount) {
            return 0;
        }
        
        const price = parseFloat(basePrice);
        const discountValue = parseFloat(couponData.discount);
        
        if (isNaN(price) || isNaN(discountValue) || discountValue <= 0) {
            return 0;
        }
        
        if (couponData.min_amount) {
            const minAmount = parseFloat(couponData.min_amount);
            if (!isNaN(minAmount) && price < minAmount) {
                return 0;
            }
        }
        
        let discountAmount = 0;
        
        if (couponData.type === 'percent') {
            const percentValue = Math.min(discountValue, 100);
            discountAmount = (price * percentValue) / 100;
        } else if (couponData.type === 'fixed') {
            discountAmount = discountValue;
        } else {
            return 0;
        }
        
        if (couponData.max_amount) {
            const maxAmount = parseFloat(couponData.max_amount);
            if (!isNaN(maxAmount) && maxAmount > 0) {
                discountAmount = Math.min(discountAmount, maxAmount);
            }
        }
        
        discountAmount = Math.min(discountAmount, price);
        
        return Math.max(discountAmount, 0);
    }

    function displayCouponInfo(couponData) {
        let couponContainer = hostRenewForm.querySelector('#dispay_coupon_apply');
        if (couponContainer) {
            let minAmount = couponData.min_amount ? formatPrice(couponData.min_amount) : 'Không có';
            let maxAmount = couponData.max_amount ? formatPrice(couponData.max_amount) : 'Không giới hạn';
            
            let discountText = couponData.type === 'percent' ? 
                `${couponData.discount}%` : 
                `${formatPrice(couponData.discount)}đ`;
            
            couponContainer.innerHTML = `
                <div class="border border-primary border-dashed bg-light-primary rounded-3">
                    <div class="p-3">
                        <div class="d-flex align-items-start gap-2">
                            <img src="${couponData.image || '/assets/images/default-coupon.png'}" height="43" class="rounded-3">
                            <div class="flex-grow-1">
                                <div class="fw-semibold txt-primary">${couponData.name} - ${discountText}</div>
                                <div class="text-muted f-12">
                                    Tối thiểu: ${minAmount}đ - Tối đa: ${maxAmount}đ
                                </div>
                                ${couponData.note ? `<div class="text-muted f-12 mt-1">${couponData.note}</div>` : ''}
                            </div>
                            <button type="button" class="btn btn-sm btn-step-ghost txt-primary" onclick="removeHostingCoupon()" title="Hủy mã giảm giá">
                                <i class="fad fa-times text-purple"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            
            couponContainer.style.display = 'block';
        }
    }

    function validateCoupon(couponData) {
        if (typeof SERVICE !== 'undefined' && couponData.service !== 'ALL' && couponData.service !== SERVICE) {
            return {
                isValid: false,
                icon: 'error',
                title: 'Mã giảm giá không hợp lệ!',
                message: 'Mã giảm giá của quý khách chỉ áp dụng cho dịch vụ ' + couponData.service + ' không hỗ trợ cho dịch vụ ' + SERVICE + '!'
            };
        }
    
        if (typeof CATEGORY !== 'undefined' && couponData.category !== 'ALL' && couponData.category) {
            let categoryId = typeof couponData.category === 'object' ? couponData.category.id : couponData.category;
            let categoryName = typeof couponData.category === 'object' ? couponData.category.name : couponData.category;
            
            if (String(categoryId) !== String(CATEGORY)) {
                return {
                    isValid: false,
                    icon: 'error',
                    title: 'Chuyên mục không hợp lệ!',
                    message: 'Mã giảm giá của quý khách chỉ áp dụng cho chuyên mục ' + categoryName + ' không hỗ trợ cho chuyên mục ' + CATEGORY_NAME + '!'
                };
            }
        }
    
        if (typeof SUBCATEGORY !== 'undefined' && couponData.category !== 'ALL' && couponData.subcategory !== 'ALL' && couponData.subcategory) {
            let subcategoryId = typeof couponData.subcategory === 'object' ? couponData.subcategory.id : couponData.subcategory;
            let subcategoryName = typeof couponData.subcategory === 'object' ? couponData.subcategory.name : couponData.subcategory;
            
            if (String(subcategoryId) !== String(SUBCATEGORY)) {
                return {
                    isValid: false,
                    icon: 'error',
                    title: 'Sản phẩm không hợp lệ!',
                    message: 'Mã giảm giá của quý khách chỉ áp dụng cho sản phẩm ' + subcategoryName + ' không hỗ trợ cho sản phẩm ' + SUBCATEGORY_NAME + '!'
                };
            }
        }
    
        if (typeof SUBSCRIPTION !== 'undefined' && couponData.category !== 'ALL' && couponData.subcategory !== 'ALL' && couponData.subscription !== 'ALL' && couponData.subscription) {
            let subscriptionId = typeof couponData.subscription === 'object' ? couponData.subscription.id : couponData.subscription;
            let subscriptionName = typeof couponData.subscription === 'object' ? couponData.subscription.name : couponData.subscription;
            
            if (String(subscriptionId) !== String(SUBSCRIPTION)) {
                return {
                    isValid: false,
                    icon: 'error',
                    title: 'Gói không hợp lệ!',
                    message: 'Mã giảm giá của quý khách chỉ áp dụng cho gói đăng ký ' + subscriptionName + ' không hỗ trợ cho gói ' + SUBSCRIPTION_NAME + '!'
                };
            }
        }
    
        let currentTotalPayment = calculateCurrentTotalPayment();
        
        if (couponData.min_amount && currentTotalPayment < parseFloat(couponData.min_amount)) {
            return {
                isValid: false,
                icon: 'warning',
                title: 'Đơn hàng chưa đủ điều kiện!',
                message: `Đơn hàng cần đạt tổng thanh toán tối thiểu ${formatPrice(couponData.min_amount)} VNĐ để áp dụng mã giảm giá!`
            };
        }
    
        return { isValid: true };
    }

    function calculateCurrentTotalPayment() {
        let selectedDuration = hostRenewForm.querySelector('input[name="duration"]:checked');
        if (!selectedDuration) return 0;

        let price = parseFloat(selectedDuration.getAttribute("data-price")) || 0;

        let vatRate = typeof VAT !== "undefined" ? parseFloat(VAT) : 0;
        let vatAmount = (price * vatRate) / 100;

        return price + vatAmount;
    }

    function resetCoupon() {
        currentDiscount = 0;
        currentCouponData = null;
        
        let couponContainer = hostRenewForm.querySelector('#dispay_coupon_apply');
        if (couponContainer) {
            couponContainer.style.display = 'none';
            couponContainer.innerHTML = '';
