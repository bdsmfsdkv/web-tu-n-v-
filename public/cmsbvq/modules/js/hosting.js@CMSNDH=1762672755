                const subcategoryElement = document.querySelector(`input[name="subcategory"][value="${selectionData.subcategory}"]`);
                const currentSubcategoryName = subcategoryElement ? subcategoryElement.getAttribute('data-subcategory-name') || 'đã chọn' : 'đã chọn';
                
                return {
                    isValid: false,
                    title: 'Sản phẩm không hợp lệ!',
                    message: `Mã giảm giá của quý khách chỉ áp dụng cho sản phẩm ${subcategoryName} không hỗ trợ cho sản phẩm ${currentSubcategoryName}!`
                };
            }
        }

        // Subscription validation
        if (couponData.category !== 'ALL' && couponData.subcategory !== 'ALL' && couponData.subscription !== 'ALL' && couponData.subscription) {
            // Handle subscription as object or string
            let subscriptionId = typeof couponData.subscription === 'object' ? couponData.subscription.id : couponData.subscription;
            let subscriptionName = typeof couponData.subscription === 'object' ? couponData.subscription.name : couponData.subscription;
            
            if (subscriptionId != selectionData.subscription) {
                // Get subscription name for display
                const subscriptionElement = document.querySelector(`input[name="subscription"][value="${selectionData.subscription}"]`);
                const currentSubscriptionName = subscriptionElement ? 
                    subscriptionElement.closest('.form-check').querySelector('.text-uppercase.fs-6.fw-bolder').textContent || 'đã chọn' : 'đã chọn';
                
                return {
                    isValid: false,
                    title: 'Gói không hợp lệ!',
                    message: `Mã giảm giá của quý khách chỉ áp dụng cho gói đăng ký ${subscriptionName} không hỗ trợ cho gói ${currentSubscriptionName}!`
                };
            }
        }

        // Minimum amount validation
        if (couponData.min_amount && selectionData.totalAmount < parseFloat(couponData.min_amount)) {
            return {
                isValid: false,
                title: 'Đơn hàng chưa đủ điều kiện!',
                message: `Đơn hàng cần đạt tổng thanh toán tối thiểu ${formatPrice(couponData.min_amount)}đ để áp dụng mã giảm giá!`
            };
        }

        return { isValid: true };
    }

    function applyHostingCoupon(couponData) {
        // Calculate discount using the updated function
        const basePrice = parseFloat(selectedDuration.price) || 0;
        const discountAmount = calculateCouponDiscount(basePrice, couponData);

        // Update total price display
        const finalPrice = basePrice - discountAmount;
        
        // Show discount row
        const discountRow = document.querySelector('.total-coupon-discount').closest('tr');
        if (discountRow) {
            discountRow.style.display = 'table-row';
            document.querySelector('.total-coupon-discount').textContent = formatPrice(discountAmount) + 'đ';
        }

        // Update final payment
        document.querySelector('.total-payment').textContent = formatPrice(finalPrice) + 'đ';

        // Show coupon info
        displayHostingCouponInfo(couponData);
    }

    function displayHostingCouponInfo(couponData) {
        const couponDisplay = document.getElementById('dispay_coupon_apply');
        if (couponDisplay) {
            // Hiển thị đúng loại coupon
            let discountText = '';
            if (couponData.type === 'fixed') {
                discountText = `Giảm ${formatPrice(couponData.discount)}đ`;
            } else if (couponData.type === 'percent') {
                discountText = `Giảm ${couponData.discount}%`;
            }

            couponDisplay.innerHTML = `
            <div class="border border-primary border-dashed bg-light-primary rounded-3">
                <div class="p-3">
                    <div class="d-flex align-items-start gap-2">
                        <img src="${couponData.image}" height="43" class="rounded-3">
                        <div class="flex-grow-1">
                            <div class="fw-semibold txt-primary">${couponData.name} - ${discountText}</div>
                            <div class="text-muted f-12">
                                Tối thiểu: ${formatPrice(couponData.min_amount)}đ - Tối đa: ${formatPrice(couponData.max_amount)}đ
                            </div>
                            ${couponData.note ? `<div class="text-muted f-12 mt-1">${couponData.note}</div>` : ''}
                        </div>
                        <button type="button" class="btn btn-sm btn-step-ghost txt-primary" onclick="removeHostingCoupon()" title="Hủy mã giảm giá">
                            <i class="fad fa-times text-purple"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
            couponDisplay.style.display = 'block';
        }
    }

    // Global function for removing coupon with SweetAlert confirmation
    window.removeHostingCoupon = function() {
        showSweetAlert('Bạn có chắc chắn muốn xóa mã giảm giá?', 'question')
            .then((result) => {
                if (result.isConfirmed) {
                    // Reset coupon
                    appliedCoupon = null;
                    
                    // Reset coupon display
                    const discountRow = document.querySelector('.total-coupon-discount').closest('tr');
                    if (discountRow) {
                        discountRow.style.display = 'none';
                    }

                    const couponDisplay = document.getElementById('dispay_coupon_apply');
                    if (couponDisplay) {
                        couponDisplay.style.display = 'none';
                        couponDisplay.innerHTML = '';
                    }

                    // Reset total payment
                    const basePrice = parseFloat(selectedDuration.price) || 0;
                    document.querySelector('.total-payment').textContent = formatPrice(basePrice) + 'đ';

                    // Clear coupon input
                    document.querySelector('input[name="coupon"]').value = '';
                    
                    showSweetAlert('Đã xóa mã giảm giá', 'success');
                }
            });
    };
