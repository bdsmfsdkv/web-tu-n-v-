        } else if (months === 12) {
            durationText = '1 Năm';
        } else {
            durationText = months + ' Tháng';
        }

        hostRenewForm.querySelectorAll('.bill-duration').forEach(el => {
            if (el.closest('tr').querySelector('i.fal.fa-clock')) {
                let dataName = selectedDuration.getAttribute("data-name");
                el.textContent = dataName || durationText;
            } else if (el.closest('tr').querySelector('i.fal.fa-money')) {
                el.textContent = formatPrice(price) + 'đ';
            }
        });

        let discountAmount = 0;
        if (currentCouponData) {
            discountAmount = calculateCouponDiscount(price, currentCouponData);
        }

        hostRenewForm.querySelectorAll('.total-coupon-discount').forEach(el => {
            if (discountAmount > 0) {
                el.textContent = '-' + formatPrice(discountAmount) + 'đ';
                el.closest('tr').style.display = '';
            } else {
                el.textContent = '0đ';
                el.closest('tr').style.display = 'none';
            }
        });

        let priceAfterDiscount = price - discountAmount;

        let vatRate = typeof VAT !== "undefined" ? parseFloat(VAT) : 0;
        let vatAmount = 0;
        if (vatRate > 0) {
            vatAmount = (priceAfterDiscount * vatRate) / 100;
            hostRenewForm.querySelectorAll('tr').forEach(tr => {
                if (tr.querySelector('.bill-vat')) {
                    tr.style.display = '';
                    tr.querySelector('.bill-vat').textContent = formatPrice(vatAmount) + 'đ';
                }
            });
        }

        let finalPayment = priceAfterDiscount + vatAmount;

        hostRenewForm.querySelectorAll('.bill-payment').forEach(el => {
            el.textContent = formatPrice(finalPayment) + 'đ';
        });
    }

    function formatPrice(price) {
        if (!price || price === 0) return '0';
        return new Intl.NumberFormat("vi-VN").format(parseFloat(price));
    }

    function numberFormat(number) {
        return formatPrice(number);
    }

    updateBillInfo();
});
/* END Hosting Renewal Price Calculator + Enhanced Coupon Validation */

