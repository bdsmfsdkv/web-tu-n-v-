    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    color: transparent !important;
    border-radius: 4px;
}

@keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}
</style>
`;

function initHostingResources() {
    if (typeof ROUTE_NAME === 'undefined') {
        return;
    }
    
    if (ROUTE_NAME !== 'HOSTING_DETAIL') {
        return;
    }
    
    if (typeof ROUTE_HANDLE === 'undefined') {
        return;
    }
    
    if (typeof ORDER_ID === 'undefined') {
        return;
    }
    
    let resourceInterval;

    function loadHostingResources() {
        if (typeof $ === 'undefined') {
            return;
        }
        
        $.ajax({
            url: ROUTE_HANDLE,
            method: 'GET',
            data: {
                key: ACCESS_TOKEN,
                action: 'resources',
                hosting: ORDER_ID
            },
            beforeSend: function() {
                if (!$('#cpu-progress').hasClass('loaded')) {
                    showSkeletonLoading();
                }
            },
            success: function(response) {
                if (response.status === 'success') {
                    updateResourcesDisplay(response.data);
                    hideSkeletonLoading();
                } else {
                    showErrorState();
                }
            },
            error: function(xhr, status, error) {
                showErrorState();
                hideSkeletonLoading();
            }
        });
    }

    function showSkeletonLoading() {
        $('#cpu-progress, #ram-progress, #disk-progress, #process-progress').addClass('skeleton-progress skeleton');
        $('#cpu-text, #ram-text, #disk-text, #process-text').addClass('skeleton-text').text('Loading...');
    }

    function hideSkeletonLoading() {
        $('#cpu-progress, #ram-progress, #disk-progress, #process-progress').removeClass('skeleton-progress skeleton').addClass('loaded');
        $('#cpu-text, #ram-text, #disk-text, #process-text').removeClass('skeleton-text');
    }

    function updateResourcesDisplay(data) {
        const cpuPercentage = data.resource_usage.cpu.percentage || 0;
        $('#cpu-progress').css('width', cpuPercentage + '%').attr('aria-valuenow', cpuPercentage);
        $('#cpu-text').text(`${cpuPercentage}% (${data.resource_usage.cpu.usage}/${data.resource_usage.cpu.maximum})`);

        const ramPercentage = data.resource_usage.ram.percentage || 0;
        $('#ram-progress').css('width', ramPercentage + '%').attr('aria-valuenow', ramPercentage);
        $('#ram-text').text(`${ramPercentage}% (${data.resource_usage.ram.formatted_usage}MB/${data.resource_usage.ram.formatted_maximum}MB)`);

        const diskPercentage = (data.disk_usage.phamtram * 100).toFixed(2);
        $('#disk-progress').css('width', diskPercentage + '%').attr('aria-valuenow', diskPercentage);
        $('#disk-text').text(`${diskPercentage}% (${data.disk_usage.disk_used}MB/${data.disk_usage.disk_limit}MB)`);

        const processPercentage = data.resource_usage.process.percentage || 0;
        $('#process-progress').css('width', processPercentage + '%').attr('aria-valuenow', processPercentage);
        $('#process-text').text(`${processPercentage}% (${data.resource_usage.process.usage}/${data.resource_usage.process.maximum})`);
    }

    function showErrorState() {
        $('#cpu-text, #ram-text, #disk-text, #process-text').text('Error loading data');
        $('#cpu-progress, #ram-progress, #disk-progress, #process-progress').css('width', '0%');
    }

    loadHostingResources();

    resourceInterval = setInterval(function() {
        loadHostingResources();
    }, 10000);

    $(window).on('beforeunload', function() {
        if (resourceInterval) {
            clearInterval(resourceInterval);
        }
    });
}

if (typeof $ !== 'undefined') {
    $(document).ready(function() {
        $('head').append(skeletonCSS);
        setTimeout(initHostingResources, 100);
    });
} else {
    document.addEventListener('DOMContentLoaded', function() {
        document.head.insertAdjacentHTML('beforeend', skeletonCSS);
        
        const checkJQuery = setInterval(function() {
            if (typeof $ !== 'undefined') {
                clearInterval(checkJQuery);
                setTimeout(initHostingResources, 100);
            }
        }, 100);
    });
}
/*** END GET RESOURCES HOSTING ***/


/* START Hosting Renewal Price Calculator + Enhanced Coupon Validation */
document.addEventListener("DOMContentLoaded", function () {
    if (typeof ROUTE_NAME === 'undefined' || ROUTE_NAME !== 'HOSTING_DETAIL') {
        return;
    }

    const hostRenewForm = document.getElementById('host-renew-form');
    if (!hostRenewForm) {
        return;
    }

    let currentDiscount = 0;
    let currentCouponData = null;
    
    hostRenewForm.querySelectorAll('input[name="duration"]').forEach(function(input) {
        input.addEventListener('change', function() {
            hostRenewForm.querySelectorAll('.offer-check .form-check').forEach(function(fc) {
                fc.classList.remove('active-select');
            });
            
            if (input.checked) {
                input.closest('.form-check').classList.add('active-select');
