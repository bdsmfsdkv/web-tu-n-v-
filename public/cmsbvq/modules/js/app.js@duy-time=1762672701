$(document).ready(function() {
    $('.action-form').on('submit', function(e) {
        e.preventDefault();

        var form = $(this);
        var submitBtn = form.find('button[type="submit"]');
        var originalText = submitBtn.html();
        var TOKEN = ACCESS_TOKEN || '';
        var showSubmitText = form.data('submit-text') !== false && form.data('submit-text') !== 'false';

        var title = form.data('title') || 'Xác nhận thao tác';
        var message = form.data('message') || 'Bạn có chắc chắn muốn thực hiện thao tác này không?';
        var needConfirm = form.data('confirm') !== false && form.data('confirm') !== 'false';
        var autoReload = form.data('reload') === true || form.data('reload') === 'true';
        var timer = form.data('timer') || 0; // Thời gian tự đóng alert (ms)

        var actionUrl = form.attr('action');
        if (!actionUrl || actionUrl === '') {
            actionUrl = ROUTE_HANDLE;
        }

        var formData = form.serialize();
        if (!form.find('input[name="key"]').length) {
            var keyValue = TOKEN || '';
            formData += '&key=' + encodeURIComponent(keyValue);
        }

        function executeAjax() {
            Swal.fire({
                title: 'Hệ thống đang xử lý dữ liệu...',
                text: 'Vui lòng chờ đợi trong giây lát.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: actionUrl,
                type: 'POST',
                data: formData,
                dataType: 'json',
                beforeSend: function() {
                    if (showSubmitText) {
                        submitBtn.html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang xử lý...');
                    } else {
                        submitBtn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');
                    }
                    submitBtn.prop('disabled', true);
                },
                success: function(response) {
                    Swal.close();

                    if (response.status === 'success') {
                        let swalConfig = {
                            title: response.title || 'Thành công!',
                            text: response.message || 'Thao tác đã được thực hiện thành công!',
                            icon: 'success',
                            confirmButtonText: 'Đóng',
                        };

                        if (timer > 0) {
                            // Nếu có timer, tự đóng alert sau timer ms, ẩn nút confirm luôn
                            swalConfig.showConfirmButton = false;
                            swalConfig.timer = timer;
                        }

                        Swal.fire(swalConfig).then(() => {
                            if (response.redirect) {
                                window.location.href = response.redirect;
                            } else if (response.reload || autoReload) {
                                location.reload();
                            }
                        });
                    } else {
                        Swal.fire({
                            title: response.title || 'Thất bại!',
                            text: response.message || 'Có lỗi xảy ra, vui lòng thử lại sau!',
                            icon: 'error',
                            confirmButtonText: 'Đóng'
                        });
                    }
                },
                error: function(xhr) {
                    Swal.close();
                    var response = xhr.responseJSON;
                    Swal.fire({
                        title: response && response.title ? response.title : 'Thất bại!',
                        text: response && response.message ? response.message : 'Có lỗi xảy ra, vui lòng thử lại sau!',
                        icon: 'error',
                        confirmButtonText: 'Đóng'
                    });
                },
                complete: function() {
                    submitBtn.prop('disabled', false).html(originalText);
                }
            });
        }

        function runSubmit() {
            if (needConfirm) {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Xác nhận',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        executeAjax();
                    } else {
                        submitBtn.prop('disabled', false).html(originalText);
                    }
                });
            } else {
                executeAjax();
            }
        }

        runSubmit();
    });
});

function action() {
    var btn = $(event.target).closest('button');
    var originalText = btn.html();
    var route = btn.data('route');
    var payload = btn.data('payload') || {};
    var method = btn.data('method') || 'POST';
    var needConfirm = btn.data('confirm') !== false && btn.data('confirm') !== 'false';
    var title = btn.data('title') || 'Xác nhận thao tác';
    var message = btn.data('message') || 'Bạn có chắc chắn muốn thực hiện thao tác này không?';
    var autoReload = btn.data('reload') === true || btn.data('reload') === 'true';
    var timer = btn.data('timer') || false;
    var loadingText = btn.data('text') || '<span class="spinner-border spinner-border-sm" style="width: 14px; height: 14px;" role="status" aria-hidden="true"></span> Đang xử lý...';

    // Detect mobile
    var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

    // Parse payload string (if any)
    if (typeof payload === 'string') {
        try {
            payload = JSON.parse(payload.replace(/'/g, '"'));
        } catch (e) {
            console.error("Payload JSON parse error:", e);
            payload = {};
        }
    }

    function showSuccess(title, message, redirect) {
        if (isMobile) {
            new Notify({
                status: "success",
                title: title || "Thành công",
                text: message || "Thao tác thành công!",
                autotimeout: timer || 3000,
                speed: 300,
                autoclose: true,
                effect: 'slide'
            });
            if (redirect) setTimeout(() => window.location.href = redirect, 1000);
            else if (autoReload) setTimeout(() => location.reload(), 1000);
        } else {
            Swal.fire({
                title: title || "Thành công!",
                text: message || "Thao tác thành công!",
                icon: "success",
                confirmButtonText: "Đóng",
                timer: timer || undefined
            }).then(() => {
                if (redirect) window.location.href = redirect;
                else if (autoReload) location.reload();
            });
        }
    }

    function showError(title, message) {
        if (isMobile) {
            new Notify({
                status: "error",
                title: title || "Thất bại",
                text: message || "Đã có lỗi xảy ra!",
                autotimeout: timer || 3000,
                speed: 300,
                autoclose: true,
                effect: 'slide'
            });
        } else {
            Swal.fire({
                title: title || "Thất bại!",
                text: message || "Có lỗi xảy ra, vui lòng thử lại!",
                icon: "error",
                confirmButtonText: "Đóng",
                timer: timer || undefined,
                timerProgressBar: timer ? true : false
            });
        }
    }

    function executeRequest() {
        btn.html(loadingText).prop('disabled', true);

        if (!isMobile) {
            Swal.fire({
                title: 'Hệ thống đang xử lý...',
                text: 'Vui lòng chờ trong giây lát.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => Swal.showLoading()
            });
        }

        $.ajax({
            url: typeof window[route] !== 'undefined' ? window[route] : route,
            type: method,
            data: payload,
            dataType: 'json',
            success: function (response) {
                if (!isMobile) Swal.close();

                if (response.status === 'success') {
                    showSuccess(response.title, response.message, response.redirect);
                } else {
                    showError(response.title, response.message);
                }
            },
            error: function (xhr) {
                if (!isMobile) Swal.close();

                let response = xhr.responseJSON || {};
                showError(response.title, response.message);
            },
            complete: function () {
                btn.prop('disabled', false).html(originalText);
            }
        });
    }

    if (needConfirm) {
        Swal.fire({
            title: title,
            text: message,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) executeRequest();
        });
    } else {
        executeRequest();
    }
}


document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.dh-filter-menu').forEach(function(filterButton) {
        filterButton.classList.add('mb-2');

        const targetId = filterButton.getAttribute('data-target');
        const filterMenu = document.querySelector(targetId + '.dh-filter-panel');

        if (filterMenu) {
            filterMenu.style.overflow = 'hidden';
            filterMenu.style.maxHeight = '0';
            filterMenu.style.transition = 'max-height 0.4s ease, opacity 0.4s ease';
            filterMenu.style.opacity = '0';
            filterMenu.style.display = 'block';

            filterButton.addEventListener('click', function(e) {
                e.preventDefault();
                if (filterMenu.style.maxHeight === '0px' || filterMenu.style.maxHeight === '0') {
                    filterMenu.style.display = 'block';
                    filterMenu.style.maxHeight = filterMenu.scrollHeight + 'px';
                    filterMenu.style.opacity = '1';

                    filterButton.classList.remove('btn-default');
                    filterButton.classList.add('btn-danger');
                    filterButton.innerHTML = '<i class="fad fa-times me-1"></i>Đóng bộ lọc';
                } else {
                    filterMenu.style.maxHeight = '0';
                    filterMenu.style.opacity = '0';

                    filterButton.classList.remove('btn-danger');
                    filterButton.classList.add('btn-default');
                    filterButton.innerHTML = '<i class="fad fa-filter me-1"></i>Bộ lọc';

                    // Sau khi ẩn hết mới set display:none để tránh nhảy layout
                    setTimeout(() => {
                        if (filterMenu.style.maxHeight === '0px' || filterMenu.style.maxHeight === '0') {
                            filterMenu.style.display = 'none';
                        }
                    }, 400);
                }
            });
        }
    });
});

