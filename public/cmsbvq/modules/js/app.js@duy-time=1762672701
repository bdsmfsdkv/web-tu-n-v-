            title: "Lỗi hệ thống",
            text: error.message,
            autotimeout: 3000
        });
        checkbox.checked = !checkbox.checked;
    });
}

function renewStatus(id) {
    const checkbox = event.target;
    const renew = checkbox.checked ? 'true' : 'false';

    checkbox.disabled = true;

    fetch(ROUTE_HANDLE, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({
            key: ACCESS_TOKEN,
            hosting: id,
            vps: id,
            renew: renew,
            action: 'renew_status'
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.status === 'success') {
            new Notify({
                status: "success",
                title: "Thành công",
                text: data.message || (renew === 'true' ? "Đã bật chức năng tự động gia hạn" : "Đã tắt chức năng tự động gia hạn"),
                autotimeout: 3000
            });
        } else {
            new Notify({
                status: "error",
                title: "Thất bại", 
                text: data.message || "Có lỗi xảy ra khi thay đổi trạng thái",
                autotimeout: 3000
            });
            checkbox.checked = !checkbox.checked;
        }
    })
    .catch(error => {
        console.error('Error:', error);
        new Notify({
            status: "error",
            title: "Lỗi hệ thống",
            text: "Không thể kết nối đến server",
            autotimeout: 3000
        });
        checkbox.checked = !checkbox.checked;
    })
    .finally(() => {
        checkbox.disabled = false;
    });
}

/*** start random string & password ***/
$(document).ready(function() {
    // Random username
    $(document).on('click', '.dh-random-string .dh-submit-random', function() {
        const btn = $(this);
        const input = btn.siblings('input');
        
        // Show spinner ngắn
        btn.find('i').removeClass('fa-random').addClass('fa-spinner fa-spin');
        
        // Generate ngay lập tức
        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
        let username = 'user';
        for (let i = 0; i < 8; i++) {
            username += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        
        input.val(username);
        
        // Restore icon sau 100ms (chỉ để thấy spinner)
        setTimeout(() => {
            btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-random');
        }, 100);
    });

    // Random password
    $(document).on('click', '.dh-random-password .dh-submit-random', function() {
        const btn = $(this);
        const input = btn.siblings('input');
    
        btn.find('i').removeClass('fa-random').addClass('fa-spinner fa-spin');
    
        const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
        const lowercase = 'abcdefghijklmnopqrstuvwxyz';
        const numbers = '0123456789';
        const safeSpecial = '@$!_*?-';
        const allChars = uppercase + lowercase + numbers + safeSpecial;
    
        let password = '';
    
        password += uppercase.charAt(Math.floor(Math.random() * uppercase.length));
        password += lowercase.charAt(Math.floor(Math.random() * lowercase.length));
        password += numbers.charAt(Math.floor(Math.random() * numbers.length));
        password += safeSpecial.charAt(Math.floor(Math.random() * safeSpecial.length));
    
        for (let i = 4; i < 16; i++) {
            password += allChars.charAt(Math.floor(Math.random() * allChars.length));
        }
    
        password = password.split('').sort(() => Math.random() - 0.5).join('');
    
        input.val(password);
    
        setTimeout(() => {
            btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-random');
        }, 150);
    });
});

