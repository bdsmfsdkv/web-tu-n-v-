function direct(url, newTab = false) {
    if (newTab) {
        window.open(url, '_blank');
    } else {
        window.location.href = url;
    }
}

function copy(text) {
    var tempInput = document.createElement("input");
    tempInput.style.position = "absolute";
    tempInput.style.left = "-9999px";
    document.body.appendChild(tempInput);
    tempInput.value = text;
    tempInput.select();
    tempInput.setSelectionRange(0, 99999);
    document.execCommand("copy");
    document.body.removeChild(tempInput);
    new Notify({
        status: "success",
        title: "Thành công",
        text: "Sao chép thành công !",
        autotimeout: 3000,
        speed: 300,
        autoclose: true,
        effect: 'slide',
    });
}

async function pasteClipboard(sel) {
    try {
      const text = await navigator.clipboard.readText();
      document.querySelector(sel).value = text;
      new Notify({
        status: "success",
        title: "Thành công",
        text: "Paste success",
        autotimeout: 3000,
      });
    } catch {
      new Notify({
        status: "error",
        title: "Thất bại",
        text: "Paste failed",
        autotimeout: 3000,
      });
    }
  }  
  
/* SELECT2 */
$(document).ready(function () {
    const formatState = (state) => {
        if (!state.id) {
            return $('<span>' + state.text + '</span>');
        }

        let logo = $(state.element).attr('img-select2');
        if (logo) {
            return $('<span><img src="' + logo + '" class="rounded-2 me-2" style="width: 20px; height: 20px">' + state.text + '</span>');
        }

        return $('<span>' + state.text + '</span>');
    };

    $('.custom-select2').each(function () {
        let searchAttr = $(this).data('search');
        let placeholderAttr = $(this).data('placeholder');

        let allowSearch = false;
        let placeholder = "Chọn danh mục";

        if (typeof searchAttr !== 'undefined') {
            allowSearch = (searchAttr === true || searchAttr === 'true');
        }
        if (typeof placeholderAttr !== 'undefined' && placeholderAttr.trim() !== '') {
            placeholder = placeholderAttr;
        }

        $(this).select2({
            templateResult: formatState,
            templateSelection: formatState,
            width: '100%',
            minimumResultsForSearch: allowSearch ? 0 : Infinity,
            placeholder: placeholder,
            allowClear: false
        });
    });

    $('.custom-select2').on('select2:select', function (e) {
        let selectedOption = $(this).find(':selected');
        let description = selectedOption.data('description');
        $('.div-details').html(`<div class="alert bg-light-info mb-3">${description || ''}</div>`);
    });

    $('.custom-select2').on('select2:unselect', function () {
        $('.div-details').html('');
    });
});

