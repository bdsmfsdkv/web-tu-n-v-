document.addEventListener("DOMContentLoaded", function () {
    var elements = document.querySelectorAll('.dhAmount');
    elements.forEach(function(el) {
        var rawAmount = el.getAttribute('data-amount');

        if (!rawAmount || isNaN(rawAmount) || rawAmount == 0) {
            el.innerHTML = '0 <span class="f-10 fw-bold"> ' + CURRENCY_ICON + '</span>';
            return;
        }

        var convertedAmount = parseFloat(rawAmount) * CURRENCY_RATE;
        var formatted;

        if (convertedAmount < 1) {
            formatted = convertedAmount.toFixed(5).replace('.', ',');
            formatted = formatted.replace(/(,?\d*?)0+$/, '$1');
            if (formatted.endsWith(',')) {
                formatted = formatted.slice(0, -1);
            }
        } else {
            var rounded = Math.round(convertedAmount);
            formatted = rounded.toString().replace(/\B(?=(\d{3})+(?!\d))/g, CURRENCY_THOUSAND_SEPARATOR);
        }

        el.innerHTML = formatted + ' <span class="f-10 fw-bold"> ' + CURRENCY_ICON + '</span>';
    });
});
