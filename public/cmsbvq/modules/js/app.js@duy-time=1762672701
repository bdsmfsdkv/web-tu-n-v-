function CronTask(url, title) {
    new Notify({
        status: 'info',
        title: title || 'Hệ thống đang xử lý...',
        text: 'Vui lòng đợi trong giây lát...',
        autoclose: true,
        timeout: 3000, 
        closeButton: true
    });    

    let loadingOverlay = document.getElementById('loading-overlay');
    let loadingText = document.getElementById('loading-text');
    let dots = ['...', '.. ', '. ', '.. '];
    let index = 0;

    loadingOverlay.style.display = 'flex';
    loadingText.textContent = (title || 'Hệ thống đang xử lý...') + dots[index];

    let loadingInterval = setInterval(() => {
        index = (index + 1) % dots.length;
        loadingText.textContent = (title || 'Hệ thống đang xử lý...') + dots[index];
    }, 500);

    $.ajax({
        url: url,
        type: 'GET',
        success: function(response) {
            clearInterval(loadingInterval);
            loadingOverlay.style.display = 'none';

            if (response.status === 'success') {
                new Notify({
                    status: 'success',
                    title: 'Thành công',
                    text: response.message,
                    autoclose: true,
                    timeout: 3000,
                    closeButton: true
                });

                setTimeout(() => location.reload(), 1500);
            } else {
                new Notify({
                    status: 'error',
                    title: 'Lỗi',
                    text: response.message || 'Có lỗi xảy ra.',
                    autoclose: true,
                    timeout: 3000,
                    closeButton: true
                });
            }
        },
        error: function() {
            clearInterval(loadingInterval);
            loadingOverlay.style.display = 'none';

            new Notify({
                status: 'error',
                title: 'Lỗi',
                text: 'Có lỗi xảy ra!',
                autoclose: true,
                timeout: 3000,
                closeButton: true
            });
        }
    });
}


function changeStatus(id) {
    const checkbox = event.target;
    const status = checkbox.checked ? 'active' : 'inactive';
    const url = checkbox.getAttribute('url-ajax');

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({
            id: id,
            status: status,
            action: 'status'
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.status === 'success') {
            new Notify({
                status: "success",
                title: "Thành công",
                text: data.message || "Cập nhật trạng thái thành công!",
                autotimeout: 3000
            });
        } else {
            new Notify({
                status: "error",
                title: "Thất bại",
                text: data.message || "Cập nhật trạng thái thất bại!",
                autotimeout: 3000
            });
            checkbox.checked = !checkbox.checked;
        }
    })
    .catch(error => {
        new Notify({
            status: "error",
            title: "Lỗi hệ thống",
            text: error.message,
            autotimeout: 3000
        });
        checkbox.checked = !checkbox.checked;
    });
}

