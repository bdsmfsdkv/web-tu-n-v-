# ============================================================
# SePay API v2 (ADD-ON, khong thay the SPAY5S)
# Mac dinh TAT: he thong chay y nhu cu qua SPAY5S.
# KHONG commit token that len GitHub.
# ============================================================
SEPAY_ENABLED=false
SEPAY_ENV=sandbox
SEPAY_TOKEN=
SEPAY_BASE_URL=https://userapi-sandbox.sepay.vn/v2

# Production (chi doi khi da test xong sandbox):
# SEPAY_ENV=production
# SEPAY_BASE_URL=https://userapi.sepay.vn/v2

# Tuy chon
SEPAY_LIMIT=50
SEPAY_MAX_PAGES=5
SEPAY_TIMEOUT=15
SEPAY_USE_SINCE_ID=false

